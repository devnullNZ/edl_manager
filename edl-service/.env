POSTGRES_PASSWORD=change-me

# ---- Required (environment / Docker secrets only; never editable in the admin UI) ----
# Management API key (X-API-Key): list/delete/recheck calls and the /v1/admin API
API_KEY=change-me-long-random-string
# Signs admin session cookies. Changing it logs everyone out.
SECRET_KEY=change-me-another-long-random-string
# Encrypts secrets stored in the database (Panorama API key, feed password).
# MUST stay identical across restarts (min 16 characters). Back it up separately from the database:
# without it saved secrets cannot be decrypted and must be re-entered.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=change-me-a-third-long-random-string
# Admin page login (https://<host>/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Set false only if you reach the admin page over plain http (local development)
ADMIN_COOKIE_SECURE=true
# Key rotation ONLY: the old key, while ENCRYPTION_KEY holds the new one. Remove it afterwards.
# See "Encryption key rotation" in the README.
# ENCRYPTION_KEY_PREVIOUS=
# Behind a reverse proxy, list ONLY the proxy's address so the real client IP is used for
# host-level checks and rate limiting. Never use "*": any client could then forge its address.
# FORWARDED_ALLOW_IPS=172.18.0.1

# ---- Docker secrets --------------------------------------------------------
# Any of API_KEY, SECRET_KEY, ENCRYPTION_KEY, ADMIN_PASSWORD, DATABASE_URL, PANORAMA_API_KEY,
# EDL_PASSWORD can be read from a file instead, e.g.
#   ENCRYPTION_KEY_FILE=/run/secrets/edl_encryption_key
# (see "Docker secrets" in the README)

# ---- FIRST-START SEED VALUES for settings editable in the admin UI -----------
# These are read ONLY when a setting does not exist in the database yet. After the first
# start the database is authoritative; change them on the Settings page, not here.
# live | mock  (mock needs no Panorama; development only)
PANORAMA_MODE=live
PANORAMA_HOST=
PANORAMA_PORT=443
PANORAMA_API_KEY=
PANORAMA_VERIFY_TLS=false
PANORAMA_TARGET=
PANORAMA_URL_CMD=<test><url>{url}</url></test>
MOCK_CATEGORIES_FILE=
CLASSIFICATION_ENABLED=true
# wildcard policy for new installs is 'exclude' (set it on the admin page)
HIGH_RISK_CATEGORIES=malware,phishing,command-and-control,grayware,ransomware,hacking
CLASSIFICATION_CACHE_TTL_HOURS=24
RECLASSIFICATION_INTERVAL_HOURS=24
EDL_NAME=default
EDL_USER=
EDL_PASSWORD=
